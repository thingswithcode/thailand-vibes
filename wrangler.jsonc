{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thailand-vibes",
  "compatibility_date": "2026-10-18",
  "build": { "command": "npm run build && node scripts/check-dist.mjs --strict" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
