---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;
  position?: string;
  eager?: boolean;
  priority?: boolean;
  sizes?: string;
}

const { src, alt, ratio = '4 / 5', position, eager = false, priority = eager, sizes = '(max-width: 900px) 92vw, 40vw' } = Astro.props;
---
<div class="arch" style={`--ratio: ${ratio}`}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    style={position ? `object-position: ${position}` : undefined}
  />
</div>

<style>
  .arch { border-radius: 999px 999px 12px 12px; overflow: hidden; aspect-ratio: var(--ratio); }
  .arch :global(picture), .arch :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
