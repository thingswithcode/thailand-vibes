---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { t } from '../i18n';
import { LANGS, type Lang, type NavKey } from '../i18n/types';
import { otherLang, pathFor, withBase } from '../lib/urls';

interface Props {
  lang: Lang;
  path: string;
  title?: string;
  description?: string;
  onlyLangs?: readonly Lang[];
  current?: NavKey;
  noindex?: boolean;
}

const { lang, path, title, description, onlyLangs = LANGS, current, noindex = false } = Astro.props;
const d = t(lang);
const other = otherLang(lang);
const switchHref = onlyLangs.includes(other) ? pathFor(other, path) : pathFor(other);
const fullTitle = title ? `${title} | ${d.meta.siteName}` : d.meta.siteName;
const site = Astro.site;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? d.meta.description} />
    <link rel="icon" href={withBase(import.meta.env.BASE_URL, 'favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && site && <link rel="canonical" href={new URL(pathFor(lang, path), site).href} />}
    {!noindex && site && onlyLangs.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l, path), site).href} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skipToContent}</a>
    <Header lang={lang} current={current} switchHref={switchHref} otherLang={other} />
    <main id="main"><slot /></main>
    <Footer lang={lang} switchHref={switchHref} otherLang={other} />
  </body>
</html>
